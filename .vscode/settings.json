{
  "cSpell.words": [
    "Belton",
    "cyclomatic",
    "datetime",
    "endregion",
    "healthcheck",
    "pageobjects",
    "slnx",
    "Swashbuckle",
    "testid",
    "toastr",
    "tseslint",
    "wdio",
    "Weinzierl"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "tailwindCSS.experimental.configFile": "src/bhs-web-angular-app/src/styles.css",
  "files.associations": {
    "*.css": "tailwindcss",
  },
  "js/ts.preferences.autoImportSpecifierExcludeRegexes": [
    "^zod$",
  ],
  "js/ts.tsdk.path": "./src/bhs-web-angular-app/node_modules/typescript/lib"
}
